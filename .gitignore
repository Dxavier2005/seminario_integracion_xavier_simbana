"""
GITIGNORE GLOBAL PARA MONOREPOSITORIOS Y MULTIPROYECTOS
Python, FastAPI, uv, venv, Node.js y Angular
"""

# ============================================================
# 1. SISTEMA OPERATIVO Y EDITORES
# ============================================================

# Windows
**/Thumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/

# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride

# Linux
**/*~

# Visual Studio Code
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/tasks.json

# JetBrains: PyCharm, WebStorm, IntelliJ IDEA
**/.idea/
**/*.iml

# Visual Studio
**/.vs/


# ============================================================
# 2. PYTHON: ARCHIVOS GENERADOS Y CACHÉ
# ============================================================

**/__pycache__/
**/*.py[cod]
**/*$py.class

# Extensiones compiladas
**/*.so
**/*.pyd
**/*.dll

# Distribución y empaquetado
**/build/
**/dist/
**/*.egg-info/
**/eggs/
**/parts/
**/sdist/
**/wheels/
**/share/python-wheels/
**/pip-wheel-metadata/

# Herramientas de Python
**/.Python
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/htmlcov/
**/.coverage
**/.coverage.*
**/coverage.xml
**/nosetests.xml
**/pytestdebug.log

# Documentación generada
**/docs/_build/


# ============================================================
# 3. ENTORNOS VIRTUALES: uv, venv, virtualenv
# ============================================================

# Nombres habituales de entornos virtuales
**/.venv/
**/venv/
**/env/
**/ENV/
**/virtualenv/
**/virtual_env/

# Otros nombres habituales
**/.virtualenv/
**/.virtualenvs/

# Entornos con nombres personalizados (ej.: entorno/)
# No se ignoran automáticamente: añade su nombre si lo necesitas.


# ============================================================
# 4. UV: GESTOR DE PAQUETES Y PROYECTOS PYTHON
# ============================================================

# Cachés locales de uv
**/.uv_cache/
**/uv-cache/

# Entornos uv: normalmente .venv/
# uv.lock NO se ignora: se recomienda versionarlo.
# pyproject.toml NO se ignora: debe versionarse.


# ============================================================
# 5. CONFIGURACIÓN Y SECRETOS
# ============================================================

# Variables de entorno y credenciales
**/.env
**/.env.*
**/*.env
**/*.env.*
**/!.env.example
**/!.env.sample

# Claves y certificados privados
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519

# EXCEPCIONES PARA PLANTILLAS DE VARIABLES DE ENTORNO
!**/.env.example
!**/.env.sample
!**/.env.template

# Archivos locales de configuración
**/secrets.json
**/credentials.json


# ============================================================
# 6. FASTAPI Y SERVIDORES PYTHON
# ============================================================

# Logs
**/*.log
**/logs/

# Bases de datos locales
**/*.sqlite
**/*.sqlite3
**/*.db

# Archivos temporales
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*.swo

# Archivos de ejecución
**/*.pid


# ============================================================
# 7. NODE.JS Y NPM
# ============================================================

# Dependencias instaladas
**/node_modules/

# Registros de npm
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*
**/pnpm-debug.log*
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Cachés
**/.npm/
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/.pnpm-store/

# Directorios de herramientas
**/.parcel-cache/
**/.turbo/
**/.nx/
**/.cache/
**/.eslintcache
**/.stylelintcache

# Cobertura
**/coverage/


# ============================================================
# 8. ANGULAR
# ============================================================

# Compilación Angular
**/dist/
**/out-tsc/

# Caché de Angular CLI
**/.angular/cache/

# Documentación generada por TypeDoc
**/documentation/

# Angular puede usar node_modules y coverage,
# cubiertos por las reglas anteriores.


# ============================================================
# 9. FRAMEWORKS Y HERRAMIENTAS JAVASCRIPT
# ============================================================

# Next.js
**/.next/
**/out/

# Nuxt
**/.nuxt/
**/.output/

# SvelteKit
**/.svelte-kit/

# Vite
**/vite.config.*.timestamp-*
**/vite.config.ts.timestamp-*

# Astro
**/.astro/

# TypeScript generado
**/*.tsbuildinfo


# ============================================================
# 10. PRUEBAS, INFORMES Y ARCHIVOS TEMPORALES
# ============================================================

**/test-results/
**/playwright-report/
**/playwright/.cache/
**/cypress/videos/
**/cypress/screenshots/

# Archivos temporales de cualquier subproyecto
**/*.orig
**/*.rej
**/*.old


# ============================================================
# 11. ARCHIVOS LOCALES Y DE DESARROLLO
# ============================================================

# Historiales de consola
**/.python_history
**/.node_repl_history

# Archivos de respaldo
**/*.backup
**/*.cache


# ============================================================
# 12. ARCHIVOS QUE NORMALMENTE SÍ DEBES VERSIONAR
# ============================================================

# Mantener en Git:
# - pyproject.toml
# - uv.lock
# - requirements.txt
# - package.json
# - package-lock.json
# - pnpm-lock.yaml
# - yarn.lock
# - angular.json
# - tsconfig.json
# - archivos fuente .py, .ts, .html, .css
# - pruebas y documentación del proyecto
